# ============================================================================
# Pynchy Configuration — EXAMPLE
# ============================================================================
# Copy this file to config.toml and configure for your setup:
#   cp config-examples/config.toml.EXAMPLE config.toml
#
# Most settings have sensible defaults and can be omitted.
# Environment variables override TOML values using __ as the nested delimiter:
#   AGENT__NAME=mybot  →  [agent] name = "mybot"
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Agent Configuration
# ─────────────────────────────────────────────────────────────────────────────

[agent]
# Name of the assistant (used in trigger detection and message attribution)
# name = "pynchy"

# Trigger aliases (used in addition to agent name for @mentions)
# trigger_aliases = ["ghost"]

# Agent core: "openai" (default), "claude", "claude-cli", or "codex"
# core = "openai"

# Model name passed to the selected core. Default: "gpt-5.5".
# Use a model_name from litellm_config.yaml; the default expects a
# "gpt-5.5" alias there.
# model = "gpt-5.5"

# Optional fallback model for cores that support fallback retries.
# fallback_model = "gpt-5.5-mini"

# ─────────────────────────────────────────────────────────────────────────────
# API Credentials
# ─────────────────────────────────────────────────────────────────────────────
# Secrets (API keys, tokens, passwords) belong in .env, not here.
# See config-examples/.env.EXAMPLE for the template.
#
# For the Codex core, configure a Codex-capable model in litellm_config.yaml.
# Pynchy routes Codex CLI model traffic through the gateway, not host Codex auth.

# ─────────────────────────────────────────────────────────────────────────────
# Container Configuration
# ─────────────────────────────────────────────────────────────────────────────

[container]
# Container image name (built via ./container/build.sh)
# image = "pynchy-agent:latest"

# Container timeout in milliseconds (30 minutes default)
# timeout_ms = 1800000

# Maximum container output size in bytes (10MB default)
# max_output_size = 10485760

# Idle timeout in milliseconds (30 minutes default)
# idle_timeout_ms = 1800000

# Maximum concurrent agent containers
# max_concurrent = 5

# Override container runtime detection (usually auto-detected)
# Options: "docker" (built-in), "apple" (requires Apple runtime plugin)
# runtime = "docker"

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────

[server]
# HTTP server port for TUI and deploy endpoint
# port = 8484

# ─────────────────────────────────────────────────────────────────────────────
# Gateway Configuration (LiteLLM)
# ─────────────────────────────────────────────────────────────────────────────
# LLM API gateway provides credential isolation for containers.
# Two modes: LiteLLM (recommended) or builtin (simple single-key proxy).

[gateway]
# Path to LiteLLM config file (enables LiteLLM mode)
# API keys are referenced via os.environ/ in the YAML
# and set in .env — pynchy forwards them into the LiteLLM container.
# See config-examples/litellm_config.yaml.EXAMPLE.
# If not set, uses builtin mode with credentials from [secrets].
# litellm_config = "litellm_config.yaml"

# Gateway port (set to 4000 when using LiteLLM mode)
# port = 4000

# LiteLLM master key and UI credentials → set in .env (see .env.EXAMPLE):
#   GATEWAY__MASTER_KEY, GATEWAY__UI_PASSWORD

# LiteLLM Docker images (usually keep defaults)
# litellm_image = "ghcr.io/berriai/litellm:main-latest"
# postgres_image = "postgres:17-alpine"

# ─────────────────────────────────────────────────────────────────────────────
# OneCLI Agent Vault
# ─────────────────────────────────────────────────────────────────────────────
# Preferred boundary for non-LLM agent credentials. When enabled, pynchy asks
# OneCLI for proxy env vars, CA material, and onecli-managed credential stubs.
# Raw service credentials stay in OneCLI and are injected at request time.
# For GitHub, prefer a OneCLI GitHub App connection. OAuth is acceptable for a
# personal migration path, but GitHub App installation tokens are repo-scoped and
# short-lived, which matches pynchy's workspace isolation model.
#
# [onecli]
# enabled = false
# url = "http://localhost:10254"
# api_key_env = "ONECLI_API_KEY"       # pragma: allowlist secret - env var name
# project_id_env = "ONECLI_PROJECT_ID"
# fail_closed = true
# agent_identifier_prefix = "pynchy"

# ─────────────────────────────────────────────────────────────────────────────
# Scheduler & Intervals
# ─────────────────────────────────────────────────────────────────────────────

[scheduler]
# Poll interval for scheduled tasks (seconds)
# poll_interval = 60.0

# Timezone for scheduled tasks (auto-detected from system if empty)
# timezone = "America/New_York"

# Temporal service used for scheduled agent task workflows
# temporal_address = "localhost:7233"
# temporal_namespace = "default"
# temporal_task_queue = "pynchy-scheduler"

[intervals]
# Message polling interval (seconds)
# message_poll = 2.0

# IPC file polling interval (seconds)
# ipc_poll = 1.0

# Host jobs (runs shell commands directly on host, no LLM/container loop)
# [jobs.rebuild_container]
# workspace = "host"
# schedule = "0 5 * * *"
# command = "./container/build.sh"
# cwd = "."
# timeout_seconds = 1200
# quiet_on_success = true
# enabled = true

# ─────────────────────────────────────────────────────────────────────────────
# Queue Configuration
# ─────────────────────────────────────────────────────────────────────────────

[queue]
# max_retries = 5
# base_retry_seconds = 5.0

# ─────────────────────────────────────────────────────────────────────────────
# Automatic Learning
# ─────────────────────────────────────────────────────────────────────────────
# When enabled, pynchy mounts an Obsidian vault into learning-enabled agent
# containers and runs a hidden post-turn reviewer after successful turns.
#
# [learning]
# enabled = false
# review_after_turn = true
# max_attempts = 3
# packet_max_chars = 12000
# skill_max_bytes = 200000
#
# [learning.obsidian]
# vault_root = "/path/to/obsidian/vault"
# mount_path = "/workspace/vault"
# default_profile_root = "systems/pynchy/profiles/{profile}"
# memory_dir_name = "memory"
# skills_dir_name = "skills"

# ─────────────────────────────────────────────────────────────────────────────
# Command Center
# ─────────────────────────────────────────────────────────────────────────────
# The command center is the dedicated, pynchy-managed connection used for
# auto-creating chats (when needed). Set to "tui" for local-only mode.

[command_center]
# connection = "connection.slack.synapse"

# ─────────────────────────────────────────────────────────────────────────────
# Connections
# ─────────────────────────────────────────────────────────────────────────────
# Define which external connections pynchy is allowed to use.

# [connection.slack.synapse]
# bot_token_env = "SLACK__BOT_TOKEN"
# app_token_env = "SLACK__APP_TOKEN"
#
# # Connection-level security — applies to all workspaces on this connection
# # unless overridden at the chat or workspace level.
# [connection.slack.synapse.security]
# allowed_users = ["*"]
#
# [connection.slack.synapse.chat.admin-1]
# # Optional per-chat security overrides:
# # [connection.slack.synapse.chat.admin-1.security]
# # access = "readwrite"
# # trigger = "mention"

# ─────────────────────────────────────────────────────────────────────────────
# Plugin Overrides
# ─────────────────────────────────────────────────────────────────────────────
# Built-in plugins are auto-loaded from the monorepo. Use [plugins.<key>] to
# disable a specific built-in plugin:
#
# [plugins.whatsapp]
# enabled = false

# ─────────────────────────────────────────────────────────────────────────────
# Profiles, Workspaces, and Jobs
# ─────────────────────────────────────────────────────────────────────────────
# These values apply to every workspace. Workspace and profile values override.
# List fields (tags, prompts, skills, mcp_servers) are unioned across tiers.
# Scalar fields use most-specific-wins semantics. Capability maps merge by
# capability ID, with more-specific tiers replacing less-specific entries.
#
# [universal]
# tags = ["base"]
# prompts = ["base", "idle-escape"]
# context_mode = "group"
# access = "readwrite"   # "read", "write", "readwrite"
# mode = "agent"         # "agent" or "chat"
# trust = true
# trigger = "mention"    # "mention" or "always"
# allowed_users = ["owner"]  # owner, user names/IDs, group refs, or "*"

# [profiles.pynchy-admin]
# tags = ["pynchy", "pynchy-admin", "browser"]
# is_admin = true
# contains_secrets = true
# idle_terminate = false
# repo_access = "crypdick/pynchy"
# model = "chatgpt/gpt-5.3-codex"

# [profiles.pynchy-worker]
# tags = ["pynchy"]
# is_admin = false
# contains_secrets = false
# idle_terminate = true
# repo_access = "crypdick/pynchy"

# Each [workspaces.<name>] binds a configured Discord/Slack channel to a profile.
# Discord threads under that channel become dynamic isolated contexts that
# inherit the workspace profile.

# [workspaces.admin]
# profile = "pynchy-admin"
# chat = "connection.slack.synapse.chat.admin-1"

# [workspaces.code-improver]
# profile = "pynchy-worker"
# chat = "connection.slack.synapse.chat.pynchy-core-code-improver"

# CLEAN ROOM POLICY: Admin workspaces cannot have MCP servers with public_source = true.
# Any MCP not declared in [services] defaults to public_source = true.
# Pynchy refuses to start if this constraint is violated.
# See: https://pynchy.ricardodecal.com/usage/security/#admin-clean-room

# Example profile with Google MCP (dot-syntax instance names):
# [profiles.mycompany-worker]
# tags = ["mycompany", "gdrive"]
# mcp_servers = ["gdrive.mycompany", "gcal.mycompany"]
# contains_secrets = true

# Example workspace with MCP access and per-MCP kwargs:
# [workspaces.research]
# profile = "mycompany-worker"
# chat = "connection.slack.synapse.chat.research"
#
# [workspaces.research.mcp.playwright]
# presets = ["dev-research"]                   # expands + merges with explicit values
# allowed-origins = "internal.example.com"     # merged with preset domains
#
# Per-workspace capability exception:
# [workspaces.research.capabilities."mcp.email.send"]
# decision = "deny"                            # "allow", "deny", or "needs_human"

# Daily Pynchy operations triage. Replace the chat ref with the explicit
# Pynchy channel/topic that should receive the memo.
# [jobs.daily-triage]
# enabled = true
# schedule = "0 8 * * *"
# workspace = "admin"
# prompt_file = "prompts/daily-triage.md"
#
# One-time agent job:
# [jobs.cancel-youtube-premium]
# enabled = true
# at = "2026-07-08T18:30:00-07:00"
# workspace = "admin"
# prompt = """
# Open a browser, log into YouTube, and cancel the YouTube Premium subscription.
# """
#
# Host job. "host" is a reserved workspace name for direct host execution.
# [jobs.backup-runtime-dbs]
# enabled = true
# schedule = "0 3 * * *"
# workspace = "host"
# command = "scripts/backup_runtime_dbs.sh"
# cwd = "."
# timeout_seconds = 600
# quiet_on_success = true

# ─────────────────────────────────────────────────────────────────────────────
# Command Words (magic commands)
# ─────────────────────────────────────────────────────────────────────────────
# Customize the words that trigger special commands.

# [commands.reset]
# verbs = ["reset", "restart", "clear", "new", "wipe"]
# nouns = ["context", "session", "chat", "conversation"]
# aliases = ["boom", "c"]

# [commands.end_session]
# verbs = ["end", "stop", "close", "finish"]
# nouns = ["session"]
# aliases = ["done", "bye", "goodbye", "cya"]

# [commands.redeploy]
# aliases = ["r"]
# verbs = ["redeploy", "deploy"]

# ─────────────────────────────────────────────────────────────────────────────
# Slack Channel (built-in plugin)
# ─────────────────────────────────────────────────────────────────────────────
# Connects to Slack via Socket Mode. Each Slack channel/DM maps to a pynchy
# workspace with JID "slack:<CHANNEL_ID>". Activates when tokens are set.
#
# Gotcha: Auto-created workspace channels won't appear in your Slack sidebar
# automatically. Search for the channel name in Slack and join it manually.

# Slack tokens → set in .env (see .env.EXAMPLE):
#   SLACK__BOT_TOKEN, SLACK__APP_TOKEN

# ─────────────────────────────────────────────────────────────────────────────
# CalDAV (Calendar)
# ─────────────────────────────────────────────────────────────────────────────
# Built-in host-side plugin. Connects to CalDAV servers (Nextcloud, etc.)
# and exposes list_calendars, list_calendar, create_event, delete_event tools.
# Multiple servers with separate credentials are supported. Calendar names
# are auto-discovered from each server.
#
# Agents reference calendars as "server/calendar_name" or just "calendar_name"
# (resolved against the default server). "primary" maps to default_calendar.

# [caldav]
# default_server = "work"  # which server when no prefix given

# [caldav.servers.work]
# url = "https://work.nextcloud.com/remote.php/dav/"
# username = "user@work.com"
# password_env = "CALDAV_WORK_PASSWORD"  # env var in .env; see config-examples/.env.EXAMPLE  # pragma: allowlist secret
# default_calendar = "meetings"    # optional: what "primary" resolves to
# allow = ["meetings", "standup"]  # optional: only expose these calendars
# ignore = ["trash"]               # optional: hide these (ignored if allow is set)

# [caldav.servers.personal]
# url = "https://personal.nextcloud.com/remote.php/dav/"
# username = "me@example.com"
# password_env = "CALDAV_PERSONAL_PASSWORD"  # pragma: allowlist secret
# ignore = ["contact_birthdays"]   # hide auto-generated calendars

# ─────────────────────────────────────────────────────────────────────────────
# Chrome Profiles
# ─────────────────────────────────────────────────────────────────────────────
# Generic list of profile names. Any MCP server can attach to a chrome profile.
# Each profile maps to a host directory at data/chrome-profiles/{name}/.
# Auth artifacts (OAuth keys, tokens) are stored there and auto-mounted into
# containers that reference the profile.

# chrome_profiles = ["mycompany", "work"]

# ─────────────────────────────────────────────────────────────────────────────
# MCP Server Definitions
# ─────────────────────────────────────────────────────────────────────────────
# Define MCP servers that agents can access. Docker-based MCPs start on-demand
# and stop after idle_timeout. URL MCPs are always available.
# Requires LiteLLM gateway mode (see [gateway] above).
#
# Google services (gdrive, gcal) — base specs are provided by the built-in
# GoogleMcpPlugin. Declare instances with chrome_profile attachment:
#
# [mcp.gdrive.mycompany]
# chrome_profile = "mycompany"
#
# [mcp.gdrive.work]
# chrome_profile = "work"
#
# [mcp.gcal.mycompany]
# chrome_profile = "mycompany"
#
# Each instance is 2 lines. The plugin provides everything else (Docker image,
# port, transport, Dockerfile). Ports auto-assign from the base. Volume
# auto-mounts from the chrome_profile.
#
# The agent sees tools as mcp__gdrive_mycompany__search (dots → underscores).

# Docker-based MCP (container managed by pynchy):
# [mcp.playwright]
# type = "docker"
# image = "mcp/playwright:latest"
# args = ["--headless", "--port", "8931", "--host", "0.0.0.0"]
# port = 8931
# transport = "sse"
# idle_timeout = 600          # seconds; 0 = never stop
# env = { DISPLAY = ":99" }                            # static env vars
# onecli = true                                        # preferred for credentials
# onecli_agent = "workspace"                           # use workspace-scoped OneCLI agent
# env_forward = ["MY_SECRET"]                           # native fallback for host vars
# env_forward = { CONTAINER_VAR = "HOST_VAR" }          # native fallback mapping

# Slack MCP (read-only Slack access via browser tokens):
# One entry per Slack workspace — each gets its own container and tokens.
# [mcp.slack_mcp_acme]
# type = "docker"
# image = "ghcr.io/korotovsky/slack-mcp-server:latest"
# port = 8080
# transport = "http"
# env = { SLACK_MCP_HOST = "0.0.0.0", SLACK_MCP_PORT = "8080" }
# onecli = true
# env_forward = { SLACK_MCP_XOXC_TOKEN = "SLACK_XOXC_ACME", SLACK_MCP_XOXD_TOKEN = "SLACK_XOXD_ACME" }

# Remote URL-based MCP:
# [mcp.remote-api]
# type = "url"
# url = "https://api.example.com/mcp"
# transport = "streamable_http"
# auth_value_env = "SOME_API_KEY"    # env var name (never inline secrets)

# Host script MCP (subprocess managed by pynchy):
# [mcp.my_custom_tool]
# type = "script"
# command = "uv"
# args = ["run", "scripts/my-tool.py"]
# port = 8080
# transport = "streamable_http"
# idle_timeout = 600

# ─────────────────────────────────────────────────────────────────────────────
# MCP Groups — named sets of servers for convenience
# ─────────────────────────────────────────────────────────────────────────────

# [mcp_groups]
# dev-tools = ["playwright", "github-mcp"]
# social = ["twitter-mcp", "linkedin-mcp"]
# google_mycompany = ["gdrive.mycompany", "gcal.mycompany"]
# "*" is built-in — refers to every defined mcp_server

# ─────────────────────────────────────────────────────────────────────────────
# MCP Presets — reusable kwarg bundles (resolved at config load time)
# ─────────────────────────────────────────────────────────────────────────────

# [mcp_presets.dev-research]
# allowed-origins = "github.com;stackoverflow.com;docs.python.org;pypi.org"

# [mcp_presets.social-media]
# allowed-origins = "twitter.com;x.com;reddit.com;linkedin.com"

# ─────────────────────────────────────────────────────────────────────────────
# Service Trust Declarations (Lethal Trifecta Defenses)
# ─────────────────────────────────────────────────────────────────────────────
# Each service declares four trust properties that control how the security
# policy gates agent access. See docs/usage/security.md for details.
#
# Properties:
#   public_source     — Can this service deliver content from untrusted parties?
#   secret_data       — Would leaking this data cause harm?
#   public_sink       — Can this service send data to untrusted parties?
#   dangerous_writes  — Are writes irreversible or high-impact?
#
# Values: false (safe), true (risky — gated), "forbidden" (blocked entirely)
#
# Unknown services default to all-true (maximum gating). Declare a service
# here to loosen its policy.

# Personal calendar (fully trusted — no gating):
# [services.caldav]
# public_source = false
# secret_data = false
# public_sink = false
# dangerous_writes = false

# Web browser (untrusted source and sink — full gating):
# [services.playwright]
# public_source = true
# secret_data = false
# public_sink = true
# dangerous_writes = true

# Corporate Slack (untrusted input, sensitive data, can send messages):
# [services.slack_mcp_acme]
# public_source = true
# secret_data = true
# public_sink = true
# dangerous_writes = true

# Google Drive (sensitive corporate data, but you control what's in it):
# [services.gdrive]
# public_source = false
# secret_data = true
# public_sink = false
# dangerous_writes = false

# ─────────────────────────────────────────────────────────────────────────────
# Mount Security
# ─────────────────────────────────────────────────────────────────────────────
# Default blocked patterns for mount security. These are merged with patterns
# from the mount-allowlist.toml file.

# [security]
# blocked_patterns = [".ssh", ".gnupg", ".gpg", ".aws", ...]

# ─────────────────────────────────────────────────────────────────────────────
# Profiles (reusable workspace config bundles)
# ─────────────────────────────────────────────────────────────────────────────
# Profiles bundle prompts, skills, MCP servers, and other config.
# Workspaces reference a profile via `profile = "<name>"`.
# Effective config = universal ∪ profile ∪ workspace.
#
# List fields (prompts, skills, mcp_servers) are unioned across tiers.
# Scalar fields use most-specific-wins semantics.
# Capability maps merge by capability ID. MCP tool capability IDs use:
# mcp.<server-or-instance>.<tool-name>, with trailing wildcards supported.
#
# Prompts use convention-based resolution: name "base" -> prompts/base.md.

# [profiles.pynchy-dev]
# prompts = ["pynchy-admin-ops", "pynchy-code-improver"]
# skills = ["core", "ops"]
# repo_access = "owner/repo"
# idle_terminate = false
# trigger = "always"
#
# [profiles.pynchy-dev.capabilities."mcp.email.*"]
# decision = "needs_human"
#
# [profiles.pynchy-dev.capabilities."mcp.email.preview"]
# decision = "allow"      # exact match overrides the wildcard above

# [profiles.ray-bench]
# prompts = ["ray-bench"]
# repo_access = "owner/ray-bench"
# mcp_servers = ["notebook"]
