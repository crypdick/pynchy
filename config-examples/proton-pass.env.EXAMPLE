# Copy this reference-only template to data/proton-pass/pynchy.env on a
# production host. scripts/run_pynchy.sh resolves it into the Pynchy host
# process through Proton Pass CLI.

LINEAR_API_KEY=pass://Pynchy/Linear/password # pragma: allowlist secret
LINEAR_TEAM_KEY=pass://Pynchy/Linear/team-key
GITHUB_TOKEN=pass://Pynchy/GitHub/password
PYNCHY_PROTON_BRIDGE_USERNAME=pass://Pynchy/Proton Bridge/username
PYNCHY_PROTON_BRIDGE_PASSWORD_COMMAND=pass://Pynchy/Proton Bridge/password-command # pragma: allowlist secret
