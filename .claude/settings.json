{
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && uv run --project \"$root\" python \"$root/scripts/agent_hooks/guard_infrastructure_as_code.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
