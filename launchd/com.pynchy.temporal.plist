<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace $HOME and $PYNCHY_PROJECT_ROOT with absolute paths before installing;
     launchd does not expand shell variables in plist string values. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pynchy.temporal</string>
    <key>ProgramArguments</key>
    <array>
        <string>$PYNCHY_PROJECT_ROOT/scripts/run_temporal.sh</string>
        <string>/opt/homebrew/bin/temporal</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$PYNCHY_PROJECT_ROOT</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/pynchy/temporal.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/pynchy/temporal.err.log</string>
</dict>
</plist>
