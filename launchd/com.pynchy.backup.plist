<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace every $PLACEHOLDER with an absolute deployment value before installing;
     launchd does not expand shell variables in plist string values. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pynchy.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>$PYNCHY_PROJECT_ROOT/scripts/backup_runtime_dbs.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$PYNCHY_PROJECT_ROOT</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYNCHY_BACKUP_REMOTE_HOST</key>
        <string>$PYNCHY_BACKUP_REMOTE_HOST</string>
        <key>PYNCHY_BACKUP_REMOTE_DIR</key>
        <string>$PYNCHY_BACKUP_REMOTE_DIR</string>
        <key>PYNCHY_BACKUP_SSH_KEY</key>
        <string>$HOME/.ssh/pynchy_backup_ed25519</string>
        <key>PYNCHY_BACKUP_STAGING_DIR</key>
        <string>$PYNCHY_PROJECT_ROOT/data/backup-staging</string>
        <key>PYNCHY_BACKUP_KEEP_DAYS</key>
        <string>30</string>
    </dict>
    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/pynchy/backup.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/pynchy/backup.err.log</string>
</dict>
</plist>
